{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "label": "auto:release-pending",
  "release-label": "auto:release-tagged",
  "skip-github-release": true,
  "draft-pull-request": true,
  "separate-pull-requests": true,
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "perf",
      "section": "Performance Improvements"
    },
    {
      "type": "revert",
      "section": "Reverted Changes"
    },
    {
      "type": "docs",
      "section": "Documentation",
      "hidden": true
    },
    {
      "type": "style",
      "hidden": true
    },
    {
      "type": "chore",
      "hidden": true
    },
    {
      "type": "refactor",
      "hidden": true
    },
    {
      "type": "test",
      "hidden": true
    },
    {
      "type": "ci",
      "hidden": true
    },
    {
      "type": "hotfix",
      "hidden": true
    }
  ],
  "pull-request-title-pattern": "release(${component}): ${version}",
  "component-no-space": true,
  "pull-request-header": "> [!NOTE]\n> Merging this PR bumps the package version and updates the changelog.\n\nRelease notes preview: keep this section in sync with `libs/code/CHANGELOG.md`.\n",
  "pull-request-footer": "\n_End release notes preview._\n",
  "packages": {
    "libs/code": {
      "release-type": "python",
      "package-name": "niki-agent",
      "component": "niki-agent",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "extra-files": [
        "pyproject.toml",
        "niki_agent/_version.py"
      ],
      "changelog-path": "CHANGELOG.md",
      "exclude-paths": [
        "libs/code/tests"
      ]
    }
  },
  "tag-separator": "==",
  "include-component-in-tag": true,
  "include-v-in-tag": false
}
